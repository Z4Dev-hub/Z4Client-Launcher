    }

    private void OnLoaded(object sender, RoutedEventArgs e)
    {
        AnimateRoot(true);
        // Entrance: sidebar slides in, content rises.
        Reveal(Sidebar, -40, 0, 480, 0);
        Reveal(MainArea, 0, 26, 520, 120);

        _currentPage = OverviewPanel;
        StaggerOverview(260);

