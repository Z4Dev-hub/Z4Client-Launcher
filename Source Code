    // ---------------------------------------------------------------- fullscreen + scaling
    /// <summary>Scales the whole UI up on big screens instead of leaving tiny content in a huge window.</summary>
    private void ApplyScale()
    {
        if (ActualWidth <= 0 || ActualHeight <= 0) return;
        var scale = Math.Clamp(Math.Min(ActualWidth / 1280.0, ActualHeight / 820.0), 1.0, 1.8);
        Root.LayoutTransform = scale < 1.02 ? Transform.Identity : new ScaleTransform(scale, scale);
    }

    /// <summary>"Fullscreen" = maximized to the work area, so the taskbar stays visible.</summary>
    private void ToggleFullscreen() =>
        WindowState = WindowState == WindowState.Maximized ? WindowState.Normal : WindowState.Maximized;

    protected override void OnPreviewKeyDown(System.Windows.Input.KeyEventArgs e)
    {
        base.OnPreviewKeyDown(e);
