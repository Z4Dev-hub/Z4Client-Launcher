    private void ShowPage(FrameworkElement target, string title, string subtitle)
    {
        PageTitle.Text = title;
        PageSubtitle.Text = subtitle;
        Reveal(HeaderStack, -16, 0, 300, 40);

        var token = ++_navToken;
        var old = _currentPage;
        _currentPage = target;
        if (ReferenceEquals(old, target) && target.IsVisible) return;

        void Enter()
        {
            if (token != _navToken) return;
            target.Visibility = Visibility.Visible;
            if (ReferenceEquals(target, OverviewPanel))
            {
                target.BeginAnimation(OpacityProperty, null);
                target.Opacity = 1;
                StaggerOverview(0);
            }
            else
            {
                Reveal(target, 0, 22, 300, 0);
            }
        }

        if (old is not null && old.IsVisible && !ReferenceEquals(old, target))
        {
            var fade = TweenTo(0, 110);
            fade.Completed += (_, _) =>
            {
                old.Visibility = Visibility.Collapsed;
                old.BeginAnimation(OpacityProperty, null);
                old.Opacity = 1;
                Enter();
            };
            old.BeginAnimation(OpacityProperty, fade);
        }
        else Enter();
    }

    private void StaggerOverview(int baseDelay)
    {
        var i = 0;
        foreach (UIElement child in OverviewStack.Children)
        {
            Reveal(child, 0, 28, 380, baseDelay + i * 85);
            i++;
        }
    }

