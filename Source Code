    private async Task RefreshDetailLoaderVersionsAsync()
    {
        var rev = ++_detailRev;
        var loader = ((DetailLoaderBox.SelectedItem as ComboBoxItem)?.Content?.ToString() ?? "Vanilla").ToLowerInvariant();
        var mc = (DetailVersionBox.SelectedItem as MinecraftVersion)?.Id;
        if (loader == "vanilla" || mc is null)
