            DetailLoaderVersionBox.ItemsSource = new[] { "—" };
            DetailLoaderVersionBox.SelectedIndex = 0;
            DetailLoaderVersionBox.IsEnabled = false;
            return;
        }
        DetailLoaderVersionBox.IsEnabled = false;
        DetailLoaderVersionBox.ItemsSource = new[] { "Loading…" };
        DetailLoaderVersionBox.SelectedIndex = 0;
        var list = await FetchLoaderVersionsAsync(loader, mc);
        if (rev != _detailRev) return;
        var items = new List<string> { "Latest (recommended)" };
        items.AddRange(list);
        if (_detailWantedLv.Length > 0 && !items.Contains(_detailWantedLv)) items.Insert(1, _detailWantedLv);   // keep a version that is no longer listed
        DetailLoaderVersionBox.ItemsSource = items;
        var idx = _detailWantedLv.Length > 0 ? items.IndexOf(_detailWantedLv) : 0;
