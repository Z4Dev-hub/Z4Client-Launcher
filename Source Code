        try
        {
            Process.Start(new ProcessStartInfo("minecraft://") { UseShellExecute = true });
            var selected = VersionBox.SelectedItem as MinecraftVersion;
            SetStatus(selected is null
                ? "Opened the official Minecraft Launcher."
                : $"Opened the official launcher. Choose {selected.Id} in Installations and install it there.");
        }
        catch (Exception ex)
        {
            SetStatus("Could not open Minecraft Launcher: " + ex.Message + " Open it from the Start menu instead.");
        }
    }

    // ---------- content browser ----------
    private void OpenBrowser(string category, string title)
    {
        _category = category;
        CategoryText.Text = title.ToUpperInvariant();
        _results.Clear();
        EmptyText.Visibility = Visibility.Visible;
        EmptyText.Text = category == "world"
            ? "Search worlds on CurseForge, or browse local saves from Overview."
            : "Loading the most popular…";
        SearchBox.Text = "";
        ShowPage(BrowserPanel, title, $"Most popular {title.ToLowerInvariant()} on Modrinth and CurseForge. Type to search.");
        if (category != "world") _ = SearchAsync();
    }

    private async void SourceBox_SelectionChanged(object s, SelectionChangedEventArgs e)
    {
        if (!_ready || !ReferenceEquals(_currentPage, BrowserPanel)) return;
        await SearchAsync();
    }

    private static string FormatCount(string? raw)
    {
        if (!double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)) return raw ?? "0";
        return n >= 1_000_000_000 ? $"{n / 1_000_000_000:0.#}B" : n >= 1_000_000 ? $"{n / 1_000_000:0.#}M" : n >= 1_000 ? $"{n / 1_000:0.#}K" : n.ToString("0");
    }

    private async void Search_Click(object s, RoutedEventArgs e) => await SearchAsync();
    private async void SearchBox_KeyDown(object s, KeyEventArgs e) { if (e.Key == Key.Enter) await SearchAsync(); }

    private async Task SearchAsync()
    {
        var query = SearchBox.Text.Trim();
        var popular = query.Length == 0;
        var inst = ActiveInstance;
        var filter = inst is not null && inst.Version != "unspecified" ? inst : null;   // only show what fits the chosen instance
        _results.Clear();
        EmptyText.Visibility = Visibility.Visible;
        EmptyText.Text = popular ? "Loading the most popular…" : "Searching…";
        SetStatus(popular ? "Loading the most popular…" : "Searching content providers…");
        SetBusy(true);
        try
        {
            var source = (SourceBox.SelectedItem as ComboBoxItem)?.Content?.ToString() ?? "Modrinth";
            if (source == "Modrinth")
            {
                if (_category == "world")
                {
                    EmptyText.Text = "Modrinth does not expose a dedicated world-save project type. Choose CurseForge for world searches, or open local saves from Overview.";
                    SetStatus("World search is available through CurseForge.");
                    return;
                }
                await SearchModrinth(query, filter);
                if (_results.Count == 0 && filter is not null) { filter = null; await SearchModrinth(query, null); }
            }
            else
            {
                await SearchCurseForge(query, filter);
                if (_results.Count == 0 && filter is not null) { filter = null; await SearchCurseForge(query, null); }
            }

            EmptyText.Visibility = _results.Count == 0 ? Visibility.Visible : Visibility.Collapsed;
            if (_results.Count == 0) EmptyText.Text = "No results found. Try another search.";
            var fits = filter is not null ? $" • for {filter.LoaderLabel} {filter.Version}" : "";
            SetStatus(popular
                ? $"Most popular {_category}s on {source}{fits}"
                : $"{_results.Count} result(s) • {_category} • {source}{fits}");
        }
        catch (Exception ex)
        {
            EmptyText.Text = "Search failed. Check your connection and provider settings.";
            SetStatus(ex.Message);
        }
        finally { SetBusy(false); }
    }

    private async Task SearchModrinth(string query, InstanceInfo? filter)
    {
        var facet = _category switch { "mod" => "mod", "shader" => "shader", "datapack" => "datapack", "resourcepack" => "resourcepack", _ => "mod" };
        var groups = new List<string[]> { new[] { $"project_type:{facet}" } };
        if (filter is not null)
        {
            groups.Add(new[] { $"versions:{filter.Version}" });
            if (_category == "mod")
            {
                if (filter.Loader == "quilt") groups.Add(new[] { "categories:quilt", "categories:fabric" });   // Quilt runs Fabric mods
                else if (filter.Loader is "fabric" or "forge" or "neoforge") groups.Add(new[] { $"categories:{filter.Loader}" });
            }
        }
        var facets = JsonSerializer.Serialize(groups);
        var index = query.Length == 0 ? "downloads" : "relevance";   // no search text = most downloaded first
        var url = "https://api.modrinth.com/v2/search?query=" + Uri.EscapeDataString(query)
            + "&facets=" + Uri.EscapeDataString(facets) + "&limit=30&index=" + index;
        using var response = await Http.GetAsync(url);
        response.EnsureSuccessStatusCode();
        var root = JsonNode.Parse(await response.Content.ReadAsStringAsync());
        if (root?["hits"] is not JsonArray hits) return;
        foreach (var hit in hits)
        {
            var id = hit?["project_id"]?.ToString() ?? "";
            var title = hit?["title"]?.ToString() ?? "Untitled";
            var desc = hit?["description"]?.ToString() ?? "";
            var downloads = hit?["downloads"]?.ToString() ?? "0";
            var slug = hit?["slug"]?.ToString() ?? id;
            var icon = hit?["icon_url"]?.ToString();
            _results.Add(new ProjectResult(title, desc, $"Modrinth • {FormatCount(downloads)} downloads", "Modrinth", id, slug, string.IsNullOrWhiteSpace(icon) ? null : icon));
        }
    }

    private async Task SearchCurseForge(string query, InstanceInfo? filter)
    {
        if (string.IsNullOrWhiteSpace(_curseKey))
            throw new InvalidOperationException("Add a CurseForge API key in Settings to search CurseForge.");
        var classId = _category switch { "mod" => 6, "shader" => 6552, "datapack" => 6945, "world" => 17, "resourcepack" => 12, _ => 6 };
        var url = $"https://api.curseforge.com/v1/mods/search?gameId=432&classId={classId}&searchFilter={Uri.EscapeDataString(query)}&pageSize=30&sortField=2&sortOrder=desc";   // sortField 2 = popularity
        if (filter is not null)
        {
            url += "&gameVersion=" + Uri.EscapeDataString(filter.Version);
            if (_category == "mod")
            {
                var loaderType = filter.Loader switch { "forge" => 1, "fabric" => 4, "quilt" => 5, "neoforge" => 6, _ => 0 };
                if (loaderType != 0) url += "&modLoaderType=" + loaderType;
            }
        }
        using var req = new HttpRequestMessage(HttpMethod.Get, url);
        req.Headers.Add("x-api-key", _curseKey);
        using var response = await Http.SendAsync(req);
        response.EnsureSuccessStatusCode();
        var root = JsonNode.Parse(await response.Content.ReadAsStringAsync());
        if (root?["data"] is not JsonArray data) return;
        foreach (var item in data)
        {
            var id = item?["id"]?.ToString() ?? "";
            var title = item?["name"]?.ToString() ?? "Untitled";
            var desc = item?["summary"]?.ToString() ?? "";
            var downloads = item?["downloadCount"]?.ToString() ?? "0";
            var logo = item?["logo"]?["thumbnailUrl"]?.ToString();
            _results.Add(new ProjectResult(title, desc, $"CurseForge • {FormatCount(downloads)} downloads", "CurseForge", id, id, string.IsNullOrWhiteSpace(logo) ? null : logo));
        }
    }

    private async void Install_Click(object sender, RoutedEventArgs e)
    {
        if (ResultsList.SelectedItem is not ProjectResult selected) { SetStatus("Select a result first."); return; }
        SetBusy(true);
        try
        {
            SetStatus("Resolving compatible file…");
            if (selected.Source == "Modrinth") await InstallModrinth(selected);
            else await InstallCurseForge(selected);
        }
        catch (Exception ex) { SetStatus("Install failed: " + ex.Message); }
        finally { SetBusy(false); }
    }

    private async Task InstallModrinth(ProjectResult p)
    {
        var inst = ActiveInstance ?? EnsureDefaultInstance();
        var folder = Path.GetFileName(TargetFolder());
        var file = await DownloadModrinthAsync(p.Id, folder, inst, strict: folder == "mods");
        RefreshInstanceEntry(inst.Name);
        SetStatus($"Installed {p.Title} ({file}) into \"{inst.Name}\"");
    }

    /// <summary>Downloads the best-matching file of a Modrinth project into an instance folder.</summary>
    private async Task<string> DownloadModrinthAsync(string project, string folder, InstanceInfo inst, bool strict)
    {
        var query = new List<string>();
        if (folder == "mods" && !string.IsNullOrEmpty(inst.Loader) && inst.Loader != "vanilla")
            query.Add("loaders=" + Uri.EscapeDataString(JsonSerializer.Serialize(new[] { inst.Loader })));
        var versionFilter = inst.Version != "unspecified" ? "game_versions=" + Uri.EscapeDataString(JsonSerializer.Serialize(new[] { inst.Version })) : null;

        async Task<JsonNode?> FetchAsync(bool withVersion)
        {
            var qs = new List<string>(query);
            if (withVersion && versionFilter != null) qs.Add(versionFilter);
            var url = $"https://api.modrinth.com/v2/project/{Uri.EscapeDataString(project)}/version" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
            using var resp = await Http.GetAsync(url);
            resp.EnsureSuccessStatusCode();
            return (JsonNode.Parse(await resp.Content.ReadAsStringAsync()) as JsonArray)?.FirstOrDefault();
        }

        var version = await FetchAsync(true);
        if (version is null && !strict) version = await FetchAsync(false);
        if (version is null)
            throw new Exception($"No {inst.LoaderLabel} file for Minecraft {inst.Version} was found for \"{project}\".");

        var files = version["files"]?.AsArray();
        var file = files?.FirstOrDefault(x => x?["primary"]?.GetValue<bool>() == true) ?? files?.FirstOrDefault();
        var download = file?["url"]?.ToString();
        var filename = file?["filename"]?.ToString();
        if (string.IsNullOrWhiteSpace(download) || string.IsNullOrWhiteSpace(filename)) throw new Exception("No downloadable file found.");

        var target = Path.Combine(inst.Path, folder);
        Directory.CreateDirectory(target);
        var bytes = await Http.GetByteArrayAsync(download);
        await File.WriteAllBytesAsync(Path.Combine(target, Path.GetFileName(filename)), bytes);
        return Path.GetFileName(filename);
    }

    private async Task InstallCurseForge(ProjectResult p)
    {
        var url = $"https://api.curseforge.com/v1/mods/{p.Id}/files?pageSize=20&index=0";
        using var req = new HttpRequestMessage(HttpMethod.Get, url);
        req.Headers.Add("x-api-key", _curseKey);
        using var resp = await Http.SendAsync(req);
        resp.EnsureSuccessStatusCode();
        var root = JsonNode.Parse(await resp.Content.ReadAsStringAsync());
        var file = root?["data"]?.AsArray().FirstOrDefault();
        var download = file?["downloadUrl"]?.ToString();
        var filename = file?["fileName"]?.ToString();
        if (string.IsNullOrWhiteSpace(download) || string.IsNullOrWhiteSpace(filename)) throw new Exception("No direct file URL. Open the project page to download it.");
        var folder = TargetFolder();
        Directory.CreateDirectory(folder);
        var bytes = await Http.GetByteArrayAsync(download);
        await File.WriteAllBytesAsync(Path.Combine(folder, Path.GetFileName(filename)), bytes);
        RefreshInstanceEntry((ActiveInstance ?? EnsureDefaultInstance()).Name);
        SetStatus($"Downloaded {p.Title} into instance \"{ActiveInstance?.Name}\"");
    }

    private string TargetFolder()
    {
        var inst = ActiveInstance ?? EnsureDefaultInstance();
        var sub = _category switch
        {
            "shader" => "shaderpacks",
            "datapack" => "datapacks",
            "world" => "saves",
            "resourcepack" => "resourcepacks",
            _ => "mods"
        };
        return Path.Combine(inst.Path, sub);
    }

    private void OpenFolder(string name)
    {
        try
        {
            var inst = ActiveInstance ?? EnsureDefaultInstance();
            var path = name == "@root" ? _instancesRoot : name == "." ? inst.Path : Path.Combine(inst.Path, name);
            Directory.CreateDirectory(path);
            Process.Start(new ProcessStartInfo("explorer.exe", $"\"{path}\"") { UseShellExecute = true });
        }
        catch (Exception ex) { SetStatus("Could not open folder: " + ex.Message); }
    }

    private void DefaultDir_Click(object s, RoutedEventArgs e) => GameDirBox.Text = DefaultInstancesRoot;

    private void SaveSettings_Click(object s, RoutedEventArgs e)
    {
        var newRoot = string.IsNullOrWhiteSpace(GameDirBox.Text) ? _instancesRoot : GameDirBox.Text.Trim();
        var rootChanged = !string.Equals(newRoot, _instancesRoot, StringComparison.OrdinalIgnoreCase);
        _instancesRoot = newRoot;
        _curseKey = CurseKeyBox.Password.Trim();
        _autoUpdate = AutoUpdateBox.IsChecked == true;
        _updateUrl = UpdateUrlBox.Text.Trim();
        _ramMb = int.TryParse(RamBox.Text.Trim(), out var ram) ? Math.Clamp(ram, 1024, 65536) : 4096;
        RamBox.Text = _ramMb.ToString();
        try
        {
            SaveSettings();
            if (rootChanged) LoadInstances();
            SetStatus("Settings saved locally.");
        }
        catch (Exception ex) { SetStatus("Could not save settings: " + ex.Message); }
    }

    private static string ConfigPath => Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Z4ModernLauncher", "settings.json");

    private void LoadSettings()
    {
        try
        {
            if (!File.Exists(ConfigPath)) return;
            var cfg = JsonNode.Parse(File.ReadAllText(ConfigPath));
            var dir = cfg?["instancesDirectory"]?.ToString();
            if (!string.IsNullOrWhiteSpace(dir)) _instancesRoot = dir;
            _activeName = cfg?["activeInstance"]?.ToString() ?? "";
            var overrideId = cfg?["azureClientId"]?.ToString();
            if (!string.IsNullOrWhiteSpace(overrideId)) AuthConfig.ClientId = overrideId.Trim();
            _curseKey = cfg?["curseForgeApiKey"]?.ToString() ?? "";
            if (int.TryParse(cfg?["ramMb"]?.ToString(), out var savedRam)) _ramMb = Math.Clamp(savedRam, 1024, 65536);
            _autoUpdate = cfg?["autoUpdate"]?.ToString() != "False";
            _updateUrl = cfg?["updateUrl"]?.ToString() ?? "";
            var eff = cfg?["windowEffect"]?.ToString();
            if (eff is "acrylic" or "mica" or "none") _effect = eff;
            if (int.TryParse(cfg?["glass"]?.ToString(), out var g)) _glass = Math.Clamp(g, 0, 100);
        }
        catch { }
    }

    private void SaveSettings()
    {
        Directory.CreateDirectory(Path.GetDirectoryName(ConfigPath)!);
        File.WriteAllText(ConfigPath, JsonSerializer.Serialize(
            new { instancesDirectory = _instancesRoot, activeInstance = _activeName, azureClientId = AuthConfig.ClientId == AuthConfig.DefaultClientId ? "" : AuthConfig.ClientId, curseForgeApiKey = _curseKey, ramMb = _ramMb, windowEffect = _effect, glass = _glass, autoUpdate = _autoUpdate, updateUrl = _updateUrl },
            new JsonSerializerOptions { WriteIndented = true }));
    }

    // ---------------------------------------------------------------- see-through window (blur)
    private string _effect = "acrylic";
    private int _glass = 70;

    private void Discord_Click(object sender, RoutedEventArgs e)
    {
        try { Process.Start(new ProcessStartInfo("https://discord.gg/Uabq8nXReb") { UseShellExecute = true }); }
        catch (Exception ex) { SetStatus("Could not open the link: " + ex.Message); }
    }

    private void ApplyWindowLook()
    {
        var blur = false;
        try { blur = WindowEffects.Apply(this, _effect); }
        catch (Exception ex) { Program.Log("WindowEffects", ex.Message); }
        var t = blur ? _glass / 100.0 : 0.0;

        void Set(string key, byte r, byte g, byte b, double solidAlpha, double glassAlpha)
        {
            if (Application.Current.Resources[key] is SolidColorBrush brush && !brush.IsFrozen)
                brush.Color = Color.FromArgb((byte)(solidAlpha + (glassAlpha - solidAlpha) * t), r, g, b);
        }
        Set("TintBrush", 0x0A, 0x0C, 0x12, 255, 100);          // main background
        Set("SidebarGlassBrush", 0x0B, 0x0E, 0x16, 255, 120);  // sidebar
        Set("GlassBrush", 0x12, 0x16, 0x24, 255, 140);         // cards, lists, status bar
    }

    private void Effect_Changed(object sender, SelectionChangedEventArgs e)
    {
        if (!_ready) return;
        _effect = EffectBox.SelectedIndex switch { 1 => "mica", 2 => "none", _ => "acrylic" };
        ApplyWindowLook();
    }

    private void Glass_Changed(object sender, RoutedPropertyChangedEventArgs<double> e)
    {
        if (!_ready) return;
        _glass = (int)GlassSlider.Value;
        ApplyWindowLook();
    }
