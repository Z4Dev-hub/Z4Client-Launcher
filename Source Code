        _instances.Clear();
        Directory.CreateDirectory(_instancesRoot);
        foreach (var dir in Directory.GetDirectories(_instancesRoot).OrderBy(d => d, StringComparer.OrdinalIgnoreCase))
            _instances.Add(ReadInstance(dir));
        if (_instances.Count == 0) EnsureDefaultInstance();
