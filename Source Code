    private InstanceInfo CreateInstanceFolders(string name, string version, string loader, string loaderVersion = "")
    {
        var path = Path.Combine(_instancesRoot, name);
        Directory.CreateDirectory(path);
        foreach (var sub in InstanceSubfolders) Directory.CreateDirectory(Path.Combine(path, sub));
        File.WriteAllText(Path.Combine(path, "instance.json"), JsonSerializer.Serialize(
            new { name, version, loader, loaderVersion, created = DateTime.UtcNow }, new JsonSerializerOptions { WriteIndented = true }));
        return new InstanceInfo(name, version, loader, path, Summarize(path), loaderVersion);
    }

