    // ---------- versions ----------
    private async Task LoadVersionsAsync()
    {
        if (_loadingVersions) return;
        _loadingVersions = true;
        try
        {
            VersionInfoText.Text = "Fetching Mojang version manifest…";
            using var response = await Http.GetAsync(VersionManifestUrl);
            response.EnsureSuccessStatusCode();
            var root = JsonNode.Parse(await response.Content.ReadAsStringAsync());
            _versions.Clear();
            if (root?["versions"] is JsonArray items)
            {
                foreach (var item in items)
                {
                    var id = item?["id"]?.ToString();
                    var type = item?["type"]?.ToString() ?? "unknown";
                    var releaseTime = item?["releaseTime"]?.ToString() ?? "";
                    if (!string.IsNullOrWhiteSpace(id))
                        _versions.Add(new MinecraftVersion(id, type, releaseTime));
                }
            }
            VersionBox.ItemsSource = null;
            VersionBox.DisplayMemberPath = "Label";
            VersionBox.ItemsSource = _versions;
            if (_versions.Count > 0) VersionBox.SelectedIndex = 0;
            DetailVersionBox.DisplayMemberPath = "Label";
            DetailVersionBox.ItemsSource = _versions;
            if (_detail is not null) DetailVersionBox.SelectedItem = _versions.FirstOrDefault(v => v.Id == _detail.Version);
            VersionInfoText.Text = $"{_versions.Count} Java versions listed by Mojang, including historical versions where present. Select one, then open the official launcher to install and play it.";
        }
        catch (Exception ex)
        {
            VersionInfoText.Text = "Could not load Mojang's version list: " + ex.Message;
        }
        finally { _loadingVersions = false; }
    }

    private async void RefreshVersions_Click(object s, RoutedEventArgs e) => await LoadVersionsAsync();

