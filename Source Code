        var drift = new PointAnimation(new Point(0.8, 0.12), new Point(0.97, 0.85), TimeSpan.FromSeconds(7))
        { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut };
        HeroGlow.BeginAnimation(RadialGradientBrush.CenterProperty, drift);
        HeroGlow.BeginAnimation(RadialGradientBrush.GradientOriginProperty, drift.Clone());

        var pulse = new DoubleAnimation(1, 1.09, TimeSpan.FromSeconds(2.6))
        { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut };
        GlyphScale.BeginAnimation(ScaleTransform.ScaleXProperty, pulse);
        GlyphScale.BeginAnimation(ScaleTransform.ScaleYProperty, pulse.Clone());


        // Slow drifting gradient lights behind everything.
        Glow1Shift.BeginAnimation(TranslateTransform.XProperty, new DoubleAnimation(-90, 140, TimeSpan.FromSeconds(11)) { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut });
        Glow1Shift.BeginAnimation(TranslateTransform.YProperty, new DoubleAnimation(-30, 90, TimeSpan.FromSeconds(13)) { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut });
        Glow2Shift.BeginAnimation(TranslateTransform.XProperty, new DoubleAnimation(80, -160, TimeSpan.FromSeconds(14)) { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut });
        Glow2Shift.BeginAnimation(TranslateTransform.YProperty, new DoubleAnimation(40, -80, TimeSpan.FromSeconds(10)) { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut });

        // Colour-shifting accent line + hero core.
        LineStop1.BeginAnimation(GradientStop.ColorProperty, new ColorAnimation(Color.FromRgb(0x8B, 0x5C, 0xF6), Color.FromRgb(0xF4, 0x72, 0xB6), TimeSpan.FromSeconds(4)) { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut });
        LineStop2.BeginAnimation(GradientStop.ColorProperty, new ColorAnimation(Color.FromRgb(0x38, 0xBD, 0xF8), Color.FromRgb(0x8B, 0x5C, 0xF6), TimeSpan.FromSeconds(4)) { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut });
        HeroStop.BeginAnimation(GradientStop.ColorProperty, new ColorAnimation(Color.FromRgb(0x5B, 0x3F, 0xD0), Color.FromRgb(0x2F, 0x6B, 0xE8), TimeSpan.FromSeconds(6)) { AutoReverse = true, RepeatBehavior = RepeatBehavior.Forever, EasingFunction = EaseInOut });

        _ready = true;
        _ = LoadVersionsAsync();
        _ = TrySilentSignInAsync();
    }

    // ---------- window chrome ----------
    private bool _closeAnimDone;

    /// <summary>Window-level fade + scale, used for opening, closing, minimizing and restoring.</summary>
    private void AnimateRoot(bool show, Action? done = null)
    {
        var duration = TimeSpan.FromMilliseconds(show ? 240 : 140);
        var ease = new CubicEase { EasingMode = show ? EasingMode.EaseOut : EasingMode.EaseIn };
        var opacity = new DoubleAnimation(show ? 0 : 1, show ? 1 : 0, duration) { EasingFunction = ease };
        if (done is not null) opacity.Completed += (_, _) => done();
        Root.BeginAnimation(OpacityProperty, opacity);
        if (Root.RenderTransform is ScaleTransform st)
        {
            var scale = new DoubleAnimation(show ? 0.97 : 1, show ? 1 : 0.97, duration) { EasingFunction = ease };
            st.BeginAnimation(ScaleTransform.ScaleXProperty, scale);
            st.BeginAnimation(ScaleTransform.ScaleYProperty, scale.Clone());
        }
    }

    private void OnWindowClosing(object? sender, System.ComponentModel.CancelEventArgs e)
    {
        if (_closeAnimDone) return;
        e.Cancel = true;                                             // play the closing animation first, then really close
        AnimateRoot(false, () => { _closeAnimDone = true; Close(); });
    }

