        {
            var target = path.EndsWith(".disabled", StringComparison.OrdinalIgnoreCase) ? path[..^".disabled".Length] : path + ".disabled";
            File.Move(path, target, true);
            SetStatus(target.EndsWith(".disabled", StringComparison.OrdinalIgnoreCase)
