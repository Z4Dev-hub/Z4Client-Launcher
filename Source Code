    /// <summary>Newest Minecraft release that Fabric API supports (or newest release for vanilla).</summary>
    private async Task<string> ResolveGameVersionAsync(string loader)
    {
        var releases = _versions.Where(v => v.Type == "release").Select(v => v.Id).ToList();
        if (releases.Count == 0) return "unspecified";
        if (loader == "vanilla") return releases[0];
        try
        {
            using var resp = await Http.GetAsync("https://api.modrinth.com/v2/project/fabric-api");
            resp.EnsureSuccessStatusCode();
            var json = JsonNode.Parse(await resp.Content.ReadAsStringAsync());
            var supported = new HashSet<string>();
            if (json?["game_versions"] is JsonArray arr)
                foreach (var v in arr) if (v?.ToString() is { } sv) supported.Add(sv);
            foreach (var r in releases) if (supported.Contains(r)) return r;
        }
        catch (Exception ex) { Program.Log("ResolveGameVersion", ex.Message); }
        return releases[0];
    }

