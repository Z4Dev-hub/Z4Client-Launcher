        </Grid>
       </StackPanel>
      </ScrollViewer>

      <!-- detail view (the instance, opened inside the launcher) -->
      <Grid x:Name="InstanceDetailView" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,0,16">
        <DockPanel>
         <Button DockPanel.Dock="Left" Content="‹  Instances" Click="InstanceBack_Click" Margin="0,0,16,0" VerticalAlignment="Center" Padding="16,9"/>
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="Change icon" Click="ChangeIcon_Click" Margin="0,0,8,0" Padding="14,8" FontSize="12"/>
          <Button Content="Default icon" Click="ResetIcon_Click" Margin="0,0,8,0" Padding="14,8" FontSize="12"/>
          <Button Content="Show in Explorer" Tag="." Click="InstanceFolder_Click" Margin="0,0,10,0" Padding="14,8" FontSize="12"/>
          <Button x:Name="PlayButton" Content="&#x25B6;  Play" Style="{StaticResource PrimaryButton}" Padding="28,10" Click="Play_Click"/>
         </StackPanel>
         <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,14,0">
          <Border CornerRadius="13" x:Name="DetailIcon">
           <TextBlock x:Name="DetailInitial" FontWeight="Bold" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
         </Grid>
         <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DetailMeta" Foreground="{StaticResource AccentSoftBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </DockPanel>
        <WrapPanel Margin="0,14,0,0">
         <ComboBox x:Name="DetailVersionBox" Width="210" Height="34" Margin="0,0,8,6" ToolTip="Minecraft version of THIS instance only" SelectionChanged="DetailChoice_Changed"/>
         <ComboBox x:Name="DetailLoaderBox" Width="130" Height="34" Margin="0,0,8,6" ToolTip="Mod loader of THIS instance only" SelectionChanged="DetailChoice_Changed">
          <ComboBoxItem Content="Vanilla"/><ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Quilt"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/>
         </ComboBox>
         <ComboBox x:Name="DetailLoaderVersionBox" Width="190" Height="34" Margin="0,0,8,6" ToolTip="Loader version of THIS instance (Latest = newest stable)"/>
         <Button Content="Apply" Height="34" Padding="20,0" Margin="0,0,0,6" Click="ChangeVersion_Click"/>
        </WrapPanel>
        <TextBlock x:Name="DetailHint" Visibility="Collapsed" Foreground="#E8CFA0" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="This instance has no Minecraft version yet. Pick one above and press Apply, then you can play it."/>
       </StackPanel>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
        <RadioButton x:Name="TabMods" Style="{StaticResource TabPill}" GroupName="itab" Tag="mods" Content="Mods" IsChecked="True" Checked="InstanceTab_Checked"/>
        <RadioButton Style="{StaticResource TabPill}" GroupName="itab" Tag="shaderpacks" Content="Shaders" Checked="InstanceTab_Checked"/>
        <RadioButton Style="{StaticResource TabPill}" GroupName="itab" Tag="resourcepacks" Content="Resource packs" Checked="InstanceTab_Checked"/>
        <RadioButton Style="{StaticResource TabPill}" GroupName="itab" Tag="datapacks" Content="Datapacks" Checked="InstanceTab_Checked"/>
        <RadioButton Style="{StaticResource TabPill}" GroupName="itab" Tag="saves" Content="Worlds" Checked="InstanceTab_Checked"/>
        <RadioButton Style="{StaticResource TabPill}" GroupName="itab" Tag="screenshots" Content="Screenshots" Checked="InstanceTab_Checked"/>
       </StackPanel>
       <Grid Grid.Row="2" x:Name="ContentDropZone" AllowDrop="True" Background="Transparent" DragEnter="Drop_Enter" DragOver="Drop_Over" DragLeave="Drop_Leave" Drop="Drop_Drop">
        <ListBox x:Name="ContentList" SelectionMode="Extended" AllowDrop="True" MouseDoubleClick="ContentList_DoubleClick">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Border Background="{StaticResource GlassBrush}" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,12" Loaded="ResultItem_Loaded">
            <DockPanel Opacity="{Binding Dim}">
             <Border DockPanel.Dock="Left" Width="{Binding IconWidth}" Height="{Binding IconHeight}" CornerRadius="10" Background="{Binding Accent}" Margin="0,0,14,0">
              <Grid>
               <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
               <Border CornerRadius="10">
                <Border.Background><ImageBrush ImageSource="{Binding Icon, IsAsync=True}" Stretch="UniformToFill"/></Border.Background>
               </Border>
              </Grid>
             </Border>
             <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" Margin="14,0,0,0" IsChecked="{Binding Enabled, Mode=OneWay}"
                           Tag="{Binding FullPath}" Click="ModSwitch_Click" Visibility="{Binding SwitchVisibility}" ToolTip="Enable / disable"/>
             <Button DockPanel.Dock="Right" Padding="10,8" Margin="14,0,0,0" VerticalAlignment="Center" Tag="{Binding FullPath}" Click="ModGear_Click"
                     Visibility="{Binding GearVisibility}" ToolTip="Mod options (range, toggles, ...)">
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
             </Button>
             <Border DockPanel.Dock="Right" Background="#1A2033" CornerRadius="8" Padding="9,4" VerticalAlignment="Center" Visibility="{Binding StatusVisibility}">
              <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}"/>
             </Border>
             <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Detail}" Foreground="#8B93A8" FontSize="11" Margin="0,2,0,0"/>
             </StackPanel>
            </DockPanel>
           </Border>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="ContentEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="#3A4462" HorizontalAlignment="Center"/>
         <TextBlock x:Name="ContentEmptyText" Text="Nothing here yet." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
         <TextBlock Text="Drag files here, or use Add files / Browse online." Foreground="#5B6580" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid x:Name="DropOverlay" Opacity="0" IsHitTestVisible="False">
         <Rectangle RadiusX="16" RadiusY="16" Stroke="#8B5CF6" StrokeThickness="2" StrokeDashArray="4 3" Fill="#228B5CF6" Margin="2"/>
         <TextBlock Text="Drop to add to this instance" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Grid>
       </Grid>
       <DockPanel Grid.Row="3" Margin="0,14,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="Enable / disable" Click="ToggleSelected_Click"/>
         <Button Content="Remove" Margin="10,0,0,0" Click="RemoveSelected_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
         <Button Content="Add files" Style="{StaticResource PrimaryButton}" Padding="22,10" Click="AddFiles_Click"/>
         <Button Content="Browse online" Margin="10,0,0,0" Click="BrowseOnline_Click"/>
         <Button Content="Open folder" Margin="10,0,0,0" Click="OpenTabFolder_Click"/>
         <Button Content="Add Z4 Client pack" Margin="10,0,0,0" Click="AddZ4Pack_Click" ToolTip="FPS mods, 3D skin layers, voice chat and a mod list on Right Shift (Fabric only)"/>
        </StackPanel>
       </DockPanel>
      </Grid>
     </Grid>

     <!-- BROWSER -->
     <Grid x:Name="BrowserPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16" LastChildFill="True">
       <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="26,0" Height="44" Click="Search_Click"/>
       <ComboBox DockPanel.Dock="Right" x:Name="SourceBox" Width="160" Height="44" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="SourceBox_SelectionChanged">
        <ComboBoxItem Content="Modrinth"/><ComboBoxItem Content="CurseForge"/>
       </ComboBox>
       <TextBox x:Name="SearchBox" MinWidth="260" Height="44" VerticalContentAlignment="Center" ToolTip="Search projects (leave empty to see the most popular)" KeyDown="SearchBox_KeyDown"/>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,12">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="Install into" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="TargetInstanceBox" Width="210" Height="38" SelectionChanged="TargetInstanceBox_SelectionChanged"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="CategoryText" Text="MODS" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="   •   Search public projects and install compatible files" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
       </StackPanel>
      </DockPanel>
      <Border x:Name="BusyHost" Grid.Row="2" Height="3" CornerRadius="2" Background="{StaticResource Surface2Brush}" ClipToBounds="True" Margin="0,0,0,12" Visibility="Hidden">
       <Border Width="170" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource AccentGradient}">
        <Border.RenderTransform><TranslateTransform x:Name="BusyShift"/></Border.RenderTransform>
       </Border>
      </Border>
      <Grid Grid.Row="3">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Bottom" Content="Install into instance" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="24,12" Click="Install_Click"/>
        <ListBox x:Name="ResultsList">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Border Background="{StaticResource GlassBrush}" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="18" Padding="16" Loaded="ResultItem_Loaded">
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
              <Grid.Clip><RectangleGeometry Rect="0,0,52,52" RadiusX="13" RadiusY="13"/></Grid.Clip>
              <Border Background="{Binding Accent}">
               <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Image Source="{Binding Icon, IsAsync=True}" Stretch="UniformToFill"/>
             </Grid>
             <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
              <TextBlock Text="{Binding Description}" Foreground="#A6AEC0" TextWrapping="Wrap" Margin="0,5,0,0"/>
              <TextBlock Text="{Binding Meta}" Foreground="#8B93A8" FontSize="10.5" Margin="0,8,0,0"/>
             </StackPanel>
             <TextBlock Grid.Column="2" Text="↗" FontSize="18" Foreground="{StaticResource AccentSoftBrush}" VerticalAlignment="Center" Margin="18,0,4,0"/>
            </Grid>
           </Border>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>
       <TextBlock x:Name="EmptyText" Text="Loading the most popular…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
     </Grid>

     <!-- SCREENSHOTS -->
     <Grid x:Name="ScreenshotsPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14">
       <Button DockPanel.Dock="Right" Content="Open folder" Click="ShotsOpenFolder_Click" Margin="10,0,0,0"/>
       <TextBlock x:Name="ShotsCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
       <ComboBox x:Name="ShotsFilterBox" Width="260" Height="40" HorizontalAlignment="Left" SelectionChanged="ShotsFilter_Changed"/>
      </DockPanel>
      <Grid Grid.Row="1">
       <ListBox x:Name="ShotsList" SelectionMode="Extended" MouseDoubleClick="ShotsList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <StackPanel Width="230" Margin="5">
           <Border Width="230" Height="130" CornerRadius="12" Background="#1A2033">
            <Border CornerRadius="12"><Border.Background><ImageBrush ImageSource="{Binding Thumb, IsAsync=True}" Stretch="UniformToFill"/></Border.Background></Border>
           </Border>
           <TextBlock Text="{Binding Instance}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,6,0,0"/>
           <TextBlock Text="{Binding When}" Foreground="#8B93A8" FontSize="10.5" Margin="2,1,0,0"/>
          </StackPanel>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="ShotsEmpty" Text="No screenshots yet. Press F2 in the game to take one." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <DockPanel Grid.Row="2" Margin="0,14,0,0">
       <Button DockPanel.Dock="Right" Content="Delete selected" Click="ShotsDelete_Click"/>
       <Button Content="Open" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Padding="24,10" Click="ShotsOpen_Click"/>
      </DockPanel>
     </Grid>

     <!-- PROFILE -->
     <Grid x:Name="ProfilePanel" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="0,0,8,0">
        <Border x:Name="ProfileSignedOut" Style="{StaticResource Card}" Padding="28" BorderBrush="#1CFFFFFF">
         <StackPanel>
          <TextBlock Text="SKIN &amp; CAPE STUDIO" FontSize="11" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold"/>
          <TextBlock Text="Your character, your look." FontSize="26" FontWeight="Bold" Margin="0,8,0,8"/>
          <TextBlock Text="Sign in with your Microsoft account to change your skin and pick your cape. Your password goes only to Microsoft, never to this app." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="700"/>
          <Button Content="Sign in with Microsoft" HorizontalAlignment="Left" Margin="0,20,0,0" Style="{StaticResource PrimaryButton}" Padding="22,12" Click="SignIn_Click"/>
         </StackPanel>
        </Border>

        <Grid x:Name="ProfileSignedIn" Visibility="Collapsed">
         <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Style="{StaticResource Card}" Padding="22" BorderBrush="#1CFFFFFF" VerticalAlignment="Top">
          <StackPanel>
           <TextBlock Text="YOUR CHARACTER" FontSize="11" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold"/>
           <Border x:Name="ViewerHost" Height="330" Margin="0,12,0,6" Background="Transparent" Cursor="SizeAll" ClipToBounds="True"
                   MouseLeftButtonDown="Viewer_Down" MouseMove="Viewer_Move" MouseLeftButtonUp="Viewer_Up" MouseWheel="Viewer_Wheel">
            <Viewport3D x:Name="SkinViewport" ClipToBounds="True" IsHitTestVisible="False">
             <Viewport3D.Camera><PerspectiveCamera x:Name="SkinCamera" Position="0,16,72" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="32"/></Viewport3D.Camera>
            </Viewport3D>
           </Border>
           <TextBlock Text="Drag to rotate  •  scroll to zoom  •  double-click to reset" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextAlignment="Center" Margin="0,0,0,8"/>
           <TextBlock x:Name="ProfileName" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
           <TextBlock x:Name="ProfileStatus" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
         </Border>

         <StackPanel Grid.Column="1" Margin="16,0,0,0">
          <Border Style="{StaticResource Card}" Padding="22" BorderBrush="#1CFFFFFF">
           <StackPanel>
            <DockPanel>
             <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton x:Name="VariantClassic" Style="{StaticResource TabPill}" GroupName="skinvariant" Content="Classic" IsChecked="True" Checked="Variant_Changed" ToolTip="Wide (4 px) arms - Steve"/>
              <RadioButton x:Name="VariantSlim" Style="{StaticResource TabPill}" GroupName="skinvariant" Content="Slim" Checked="Variant_Changed" ToolTip="Slim (3 px) arms - Alex"/>
             </StackPanel>
             <TextBlock Text="SKINS" FontSize="11" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Your library. Pick a skin to preview it on the left, then press Use this skin." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <ListBox x:Name="SkinList" MaxHeight="260" SelectionChanged="SkinList_SelectionChanged" MouseDoubleClick="SkinList_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
             <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
             <ListBox.ItemTemplate>
              <DataTemplate>
               <StackPanel Width="92" Margin="4">
                <Border Width="64" Height="64" CornerRadius="8" Background="#1A2033" HorizontalAlignment="Center" ClipToBounds="True">
                 <Image Source="{Binding Face, IsAsync=True}" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="4"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
               </StackPanel>
              </DataTemplate>
             </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,14,0,0">
             <Button Content="Use this skin" Style="{StaticResource PrimaryButton}" Padding="22,10" Click="ApplySkin_Click" Margin="0,0,10,8"/>
             <Button Content="Add skin (PNG)…" Click="AddSkin_Click" Margin="0,0,10,8"/>
             <Button Content="Remove from library" Click="DeleteSkin_Click" Margin="0,0,10,8"/>
             <Button Content="Reset to default" Click="ResetSkin_Click" Margin="0,0,0,8"/>
            </WrapPanel>
           </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="22" BorderBrush="#1CFFFFFF" Margin="0,16,0,0">
           <StackPanel>
            <TextBlock Text="CAPES" FontSize="11" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold"/>
            <TextBlock Text="Capes your account owns. Pick one and press Equip." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <TextBlock x:Name="NoCapesText" Visibility="Collapsed" Foreground="#E8CFA0" TextWrapping="Wrap"
                       Text="This account has no capes. Capes are given by Mojang (events, Minecraft Live, migrations) and can't be added by a launcher."/>
            <ListBox x:Name="CapeList" MaxHeight="300" SelectionChanged="CapeList_SelectionChanged" MouseDoubleClick="CapeList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
             <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
             <ListBox.ItemTemplate>
              <DataTemplate>
               <StackPanel Width="110" Margin="4">
                <Image Source="{Binding Image, IsAsync=True}" Height="110" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="{Binding Alias}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="#48D597" TextAlignment="Center" Visibility="{Binding BadgeVisibility}"/>
               </StackPanel>
              </DataTemplate>
             </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,14,0,0">
             <Button Content="Equip selected cape" Style="{StaticResource PrimaryButton}" Padding="22,10" Click="EquipCape_Click" Margin="0,0,10,0"/>
             <Button Content="No cape" Click="HideCape_Click"/>
            </WrapPanel>
           </StackPanel>
          </Border>
         </StackPanel>
        </Grid>
       </StackPanel>
      </ScrollViewer>
     </Grid>

     <!-- SETTINGS -->
     <Grid x:Name="SettingsPanel" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top" BorderBrush="#1CFFFFFF">
       <StackPanel>
        <TextBlock Text="SETTINGS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentSoftBrush}"/>
        <TextBlock Text="Instances folder" Margin="0,18,0,8" FontWeight="SemiBold"/>
        <TextBox x:Name="GameDirBox" Height="44" VerticalContentAlignment="Center"/>
        <Button Content="Use default folder" HorizontalAlignment="Left" Margin="0,12,0,0" Click="DefaultDir_Click"/>
        <TextBlock Text="Memory for Minecraft (MB)" Margin="0,24,0,8" FontWeight="SemiBold"/>
        <TextBox x:Name="RamBox" Height="44" VerticalContentAlignment="Center" Text="4096" ToolTip="4096 is good for most; 6144-8192 for big modpacks"/>
        <TextBlock Text="CurseForge API key (optional)" Margin="0,24,0,8" FontWeight="SemiBold"/>
        <PasswordBox x:Name="CurseKeyBox" Height="44" VerticalContentAlignment="Center"/>
        <TextBlock Text="CurseForge search requires an API key. It is kept in this local config file; do not share the file." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock Text="Window effect" Margin="0,24,0,8" FontWeight="SemiBold"/>
        <ComboBox x:Name="EffectBox" Width="280" Height="44" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="Effect_Changed">
         <ComboBoxItem Content="Acrylic blur (see-through)"/><ComboBoxItem Content="Mica"/><ComboBoxItem Content="Off (solid)"/>
        </ComboBox>
        <TextBlock Text="Transparency" Margin="0,16,0,8" FontWeight="SemiBold"/>
        <Slider x:Name="GlassSlider" Minimum="0" Maximum="100" Value="70" Width="280" HorizontalAlignment="Left" ValueChanged="Glass_Changed"/>
        <TextBlock Text="Panels and backgrounds become see-through with a blur. Buttons and inputs always stay solid." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Text="Updates" Margin="0,28,0,8" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
        <CheckBox x:Name="AutoUpdateBox" Content="Check for updates when the launcher starts" IsChecked="True"/>
        <TextBlock Text="Update source (https link to a GitHub latest-release API address or an update.json file)" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,6"/>
        <TextBox x:Name="UpdateUrlBox" Height="44" VerticalContentAlignment="Center"/>
        <Button Content="Check for updates now" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="20,10" Click="CheckUpdates_Click"/>
        <Button Content="Save settings" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Padding="24,12" Click="SaveSettings_Click"/>
       </StackPanel>
      </Border>
     </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{StaticResource GlassBrush}" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,16,0,0">
     <DockPanel>
      <TextBlock x:Name="StatusText" Text="Welcome to Z4 Launcher" Foreground="{StaticResource MutedBrush}">
       <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
      </TextBlock>
     </DockPanel>
    </Border>
   </Grid>

   <!-- Window buttons -->
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"/>
    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click"/>
    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click"/>
   </StackPanel>
  </Grid>
  <!-- ===================== CREATE INSTANCE (in-app window) ===================== -->
  <Grid x:Name="CreateOverlay" Grid.ColumnSpan="2" Panel.ZIndex="50" Visibility="Collapsed" Background="#B3000000">
   <Border x:Name="CreateCard" Width="700" MaxHeight="780" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="20" Background="#F2121624" BorderBrush="#40FFFFFF" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="Black"/></Border.Effect>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="30,26,30,28">
      <TextBlock Text="CREATE INSTANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}"/>
      <TextBlock Text="Set up a new Minecraft instance" FontSize="22" FontWeight="Bold" Margin="0,6,0,20"/>

      <DockPanel>
       <Border x:Name="CreateIconHost" DockPanel.Dock="Left" Width="84" Height="84" CornerRadius="18" Margin="0,0,20,0" BorderBrush="#40FFFFFF" BorderThickness="1"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="CreateNameBox" Height="42" VerticalContentAlignment="Center"/>
