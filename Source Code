    private void DeleteSkin_Click(object sender, RoutedEventArgs e)
    {
        if (SkinList.SelectedItem is not SkinFile skin) { SetStatus("Pick a skin from your library first."); return; }
        if (MessageBox.Show(this, $"Remove \"{skin.Name}\" from your library? (Your account's current skin is not changed.)", "Remove skin",
                MessageBoxButton.YesNo, MessageBoxImage.Question) != MessageBoxResult.Yes) return;
        try { File.Delete(skin.Path); LoadSkinLibrary(); SetStatus("Skin removed from the library."); }
        catch (Exception ex) { SetStatus("Could not remove: " + ex.Message); }
    }

    // ---------------------------------------------------------------- capes
    private async void EquipCape_Click(object sender, RoutedEventArgs e)
    {
        if (CapeList.SelectedItem is not CapeItem cape) { SetStatus("Pick a cape first."); return; }
        var json = new JsonObject { ["capeId"] = cape.Id }.ToJsonString();
        await ProfileOpAsync("Equipping cape…",
            () => McAsync(HttpMethod.Put, "/minecraft/profile/capes/active", new StringContent(json, Encoding.UTF8, "application/json")),
            $"Cape \"{cape.Alias}\" equipped.");
    }

    private void CapeList_DoubleClick(object sender, System.Windows.Input.MouseButtonEventArgs e) => EquipCape_Click(sender, e);

    private async void HideCape_Click(object sender, RoutedEventArgs e) =>
        await ProfileOpAsync("Removing cape…", () => McAsync(HttpMethod.Delete, "/minecraft/profile/capes/active"), "Cape hidden.");

    private async Task ProfileOpAsync(string busy, Func<Task> op, string done)
    {
        if (_profileOp) return;
        _profileOp = true;
        try
        {
            SetStatus(busy);
            SetBusy(true);
            await op();
            SetStatus(done);
        }
        catch (Exception ex)
        {
            Program.Log("Profile op", ex.ToString());
            SetStatus("Failed.");
            MessageBox.Show(this, ex.Message, "Skin & Cape", MessageBoxButton.OK, MessageBoxImage.Warning);
        }
        finally
        {
            SetBusy(false);
            _profileOp = false;
        }
        await LoadProfileAsync();
    }
