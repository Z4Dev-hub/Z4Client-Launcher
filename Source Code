            SetViewerSkin(File.ReadAllBytes(skin.Path), VariantSlim.IsChecked == true);
            ProfileStatus.Text = $"Preview: {skin.Name} — press \"Use this skin\" to wear it.";
        }
        catch { }
    }

    private async void ApplySkin_Click(object sender, RoutedEventArgs e)
    {
        if (SkinList.SelectedItem is not SkinFile skin) { SetStatus("Pick a skin from your library first."); return; }
        var slim = VariantSlim.IsChecked == true;
        await ProfileOpAsync("Uploading skin…", async () =>
        {
            var bytes = File.ReadAllBytes(skin.Path);
            var err = ValidateSkin(bytes);
            if (err is not null) throw new Exception(err);
            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(slim ? "slim" : "classic"), "variant");
            var file = new ByteArrayContent(bytes);
            file.Headers.ContentType = new MediaTypeHeaderValue("image/png");
            form.Add(file, "file", "skin.png");
            await McAsync(HttpMethod.Post, "/minecraft/profile/skins", form);
        }, "Skin changed. It can take a minute to show up in game.");
    }

    private void SkinList_DoubleClick(object sender, System.Windows.Input.MouseButtonEventArgs e) => ApplySkin_Click(sender, e);

    private async void ResetSkin_Click(object sender, RoutedEventArgs e)
