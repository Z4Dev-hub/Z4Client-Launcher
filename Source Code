    // ---------------------------------------------------------------- create
    private async void CreateConfirm_Click(object sender, RoutedEventArgs e)
    {
        if (_createBusy) return;
        CreateError.Text = "";

        var name = CreateNameBox.Text.Trim();
        foreach (var c in Path.GetInvalidFileNameChars()) name = name.Replace(c.ToString(), "");
        name = name.Trim().TrimEnd('.');
        if (name.Length == 0) { CreateError.Text = "Enter a name for the instance."; return; }
        if (_instances.Any(i => string.Equals(i.Name, name, StringComparison.OrdinalIgnoreCase)))
        { CreateError.Text = $"An instance named \"{name}\" already exists."; return; }
        if (CreateVersionBox.SelectedItem is not MinecraftVersion version) { CreateError.Text = "Pick a Minecraft version."; return; }

        var loader = CreateLoader;
        var loaderVersion = CreateLoaderVersionBox.IsEnabled && CreateLoaderVersionBox.SelectedIndex > 0
            ? CreateLoaderVersionBox.SelectedItem as string ?? "" : "";
        var preset = CreatePreset;

        _createBusy = true;
        CreateConfirmButton.IsEnabled = false;
        CreateCancelButton.IsEnabled = false;
        SetBusy(true);
        try
        {
            CreateProgress.Text = "Creating instance…";
            var inst = CreateInstanceFolders(name, version.Id, loader, loaderVersion);
            if (_createIconFile is not null)
            {
                try { InstanceIcons.SetCustom(inst.Path, _createIconFile); }
                catch (Exception ex) { Program.Log("Instance icon", ex.Message); }
            }
            _instances.Add(inst);
            SetActive(inst);

            var ok = 0;
            var failed = new List<string>();
            if (preset is not null)
                (ok, failed) = await InstallPresetAsync(preset, inst, n => CreateProgress.Text = $"Downloading preinstalled mods… {n}/{preset.Items.Length}");

            RefreshInstanceEntry(inst.Name);
            CloseCreateOverlay();
            SetStatus(preset is null
                ? $"Created \"{inst.Name}\" ({inst.Meta})."
                : failed.Count == 0
                    ? $"Created \"{inst.Name}\" ({inst.Meta}) with {ok} download(s)."
                    : $"Created \"{inst.Name}\": {ok} downloaded, skipped {string.Join(", ", failed)} (no compatible file).");
            OpenInstanceDetail(ActiveInstance ?? inst);
        }
        catch (Exception ex)
        {
            Program.Log("Create instance", ex.ToString());
            CreateError.Text = "Could not create the instance: " + ex.Message;
        }
        finally
        {
            _createBusy = false;
            CreateConfirmButton.IsEnabled = true;
            CreateCancelButton.IsEnabled = true;
            CreateProgress.Text = "";
            SetBusy(false);
        }
    }

    // ---------------------------------------------------------------- preinstalled packs
    /// <summary>Downloads every item of a preset (4 at a time). Failures are skipped and returned, never fatal.</summary>
    private async Task<(int Ok, List<string> Failed)> InstallPresetAsync(PremadeInstance preset, InstanceInfo inst, Action<int> progress)
    {
        var ok = 0;
        var done = 0;
        var failed = new List<string>();
        using var gate = new SemaphoreSlim(4);
        await Task.WhenAll(preset.Items.Select(async item =>
        {
            var (slug, folder) = item;
            await gate.WaitAsync();
            try
            {
                await DownloadModrinthAsync(slug, folder, inst, strict: folder == "mods");
                Interlocked.Increment(ref ok);
            }
            catch (Exception ex)
            {
                lock (failed) failed.Add(slug);
                Program.Log("Preset item failed", slug + ": " + ex.Message);
            }
            finally
            {
                gate.Release();
                var n = Interlocked.Increment(ref done);
                _ = Dispatcher.BeginInvoke(() => progress(n));
            }
        }));
        return (ok, failed);
    }

    /// <summary>Adds the Z4 Client pack to the opened instance (Fabric only).</summary>
    private async void AddZ4Pack_Click(object sender, RoutedEventArgs e)
    {
        if (_detail is null || _createBusy) return;
        var inst = _detail;
        if (inst.Loader != "fabric")
        {
            MessageBox.Show(this, "The Z4 Client pack needs a Fabric instance. Use the loader dropdown above (set it to Fabric, then Apply) and try again.",
                "Z4 Client pack", MessageBoxButton.OK, MessageBoxImage.Information);
            return;
        }
        var preset = Premades.First(p => p.Id == "z4client");
        _createBusy = true;
        SetBusy(true);
        try
        {
            SetStatus("Adding the Z4 Client pack…");
            var (ok, failed) = await InstallPresetAsync(preset, inst, n => SetStatus($"Z4 Client pack: {n}/{preset.Items.Length}…"));
            RefreshContent();
            RefreshInstanceEntry(inst.Name);
            SetStatus(failed.Count == 0
                ? $"Z4 Client pack added ({ok} mods). Press Right Shift in game for the mod list."
                : $"Z4 Client pack: {ok} added, skipped {string.Join(", ", failed)} (no compatible file for {inst.Version}).");
        }
        catch (Exception ex) { SetStatus("Could not add the pack: " + ex.Message); }
        finally { _createBusy = false; SetBusy(false); }
    }
