    private void ImportPaths(IEnumerable<string> paths)
    {
        if (_detail is null) return;
        var dir = Path.Combine(_detail.Path, _tab);
        Directory.CreateDirectory(dir);
        var added = 0;
        foreach (var path in paths)
        {
            try
            {
                if (Directory.Exists(path))
                {
                    CopyDirectory(path, UniquePath(Path.Combine(dir, Path.GetFileName(path))));
                    added++;
                }
                else if (_tab == "saves" && path.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                {
                    ExtractWorld(path, dir);
                    added++;
                }
                else
                {
                    File.Copy(path, Path.Combine(dir, Path.GetFileName(path)), true);
                    added++;
                }
            }
            catch (Exception ex) { SetStatus($"Could not add {Path.GetFileName(path)}: {ex.Message}"); }
        }
        RefreshInstanceEntry(_detail.Name);
        RefreshContent();
        if (added > 0) SetStatus($"Added {added} item(s) to {_detail.Name}.");
    }

    private static string UniquePath(string path)
    {
        if (!Directory.Exists(path) && !File.Exists(path)) return path;
        var n = 2;
        while (Directory.Exists($"{path} ({n})") || File.Exists($"{path} ({n})")) n++;
        return $"{path} ({n})";
    }

    private static void CopyDirectory(string source, string dest)
    {
        Directory.CreateDirectory(dest);
        foreach (var f in Directory.GetFiles(source)) File.Copy(f, Path.Combine(dest, Path.GetFileName(f)), true);
        foreach (var d in Directory.GetDirectories(source)) CopyDirectory(d, Path.Combine(dest, Path.GetFileName(d)));
    }

    private static void ExtractWorld(string zip, string savesDir)
    {
        var name = Path.GetFileNameWithoutExtension(zip);
        var temp = Path.Combine(savesDir, "__import_" + Guid.NewGuid().ToString("N"));
        ZipFile.ExtractToDirectory(zip, temp);
        var root = temp;
        if (!File.Exists(Path.Combine(temp, "level.dat")))
        {
            var inner = Directory.GetDirectories(temp).FirstOrDefault(d => File.Exists(Path.Combine(d, "level.dat")));
            if (inner is not null) { root = inner; name = Path.GetFileName(inner); }
        }
        Directory.Move(root, UniquePath(Path.Combine(savesDir, name)));
        if (root != temp && Directory.Exists(temp)) Directory.Delete(temp, true);
    }

