using System.Diagnostics;
using System.IO;
using System.IO.Compression;
using System.Net.Http;
using System.Security.Cryptography;
using System.Text;
using System.Text.Json.Nodes;

namespace Z4ModernLauncher;

public static class UpdateConfig
{
    /// <summary>
    /// Where the launcher looks for new versions. Set this ONCE before you build the installer. Either:
    ///   a GitHub "latest release" API address, e.g. https://api.github.com/repos/YOURNAME/Z4Client/releases/latest
    ///   (upload the zip made by MAKE_UPDATE.bat as a release asset and tag the release with the version), or
    ///   a link to an update.json file (also made by MAKE_UPDATE.bat) hosted anywhere over https.
    /// Empty = updates are off until a user enters a source in Settings.
    /// </summary>
    public const string DefaultUrl = "https://api.github.com/repos/z4hub-code/Z4Client-Launcher/releases/latest";
}

public sealed record UpdateInfo(Version Version, string VersionText, string Url, string? Sha256, string Notes);

public static class UpdateService
{
    private static Version Norm(Version v) => new(v.Major, Math.Max(v.Minor, 0), Math.Max(v.Build, 0), Math.Max(v.Revision, 0));

    public static Version Current => Norm(typeof(UpdateService).Assembly.GetName().Version ?? new Version(1, 0, 0, 0));
    public static string CurrentText => $"{Current.Major}.{Current.Minor}.{Current.Build}";

    private static HttpClient NewClient()
    {
        var c = new HttpClient { Timeout = TimeSpan.FromSeconds(30) };
        c.DefaultRequestHeaders.UserAgent.ParseAdd("Z4Launcher/" + CurrentText);
        c.DefaultRequestHeaders.Accept.ParseAdd("application/json");
        return c;
    }

    /// <summary>Returns the newer version, or null if you are up to date.</summary>
    public static async Task<UpdateInfo?> CheckAsync(string url)
    {
        if (!url.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) throw new Exception("The update address must start with https://");
        using var http = NewClient();
        var json = JsonNode.Parse(await http.GetStringAsync(url)) ?? throw new Exception("The update information is empty.");

        string? ver, dl, sha = null, notes;
        if (json["tag_name"] is not null)                                   // GitHub release
        {
            ver = json["tag_name"]!.ToString();
            notes = json["body"]?.ToString() ?? "";
            var asset = json["assets"]?.AsArray().FirstOrDefault(a => a?["name"]?.ToString().EndsWith(".zip", StringComparison.OrdinalIgnoreCase) == true);
            dl = asset?["browser_download_url"]?.ToString();
            var digest = asset?["digest"]?.ToString();
            if (digest is not null && digest.StartsWith("sha256:", StringComparison.OrdinalIgnoreCase)) sha = digest[7..];
        }
        else                                                                // update.json
        {
            ver = json["version"]?.ToString();
            dl = json["url"]?.ToString();
            sha = json["sha256"]?.ToString();
            notes = json["notes"]?.ToString() ?? "";
        }
        if (ver is null || dl is null) throw new Exception("The update information has no version or download link.");
        if (!Version.TryParse(ver.Trim().TrimStart('v', 'V'), out var v)) throw new Exception("Unreadable version: " + ver);
        v = Norm(v);
        if (v <= Current) return null;
        if (!dl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) throw new Exception("The download link must be https.");
        return new UpdateInfo(v, $"{v.Major}.{v.Minor}.{v.Build}", dl, sha?.Trim().ToLowerInvariant(), notes.Trim());
    }

    /// <summary>The folder the launcher is installed in must be writable, otherwise it cannot replace itself.</summary>
    public static void EnsureWritable()
    {
        var dir = AppContext.BaseDirectory;
        try
        {
            var probe = Path.Combine(dir, ".z4write");
            File.WriteAllText(probe, "x");
            File.Delete(probe);
        }
        catch { throw new Exception($"The launcher can't write to its install folder ({dir}). Run Z4ClientSetup.exe once as administrator, or install to a folder like C:\\Z4Client."); }
    }

    /// <summary>Downloads, verifies and unpacks the update. Returns the folder with the new files.</summary>
    public static async Task<string> DownloadAsync(UpdateInfo info, Action<double> progress)
    {
        var work = Path.Combine(Path.GetTempPath(), "Z4Update_" + Guid.NewGuid().ToString("N")[..8]);
        Directory.CreateDirectory(work);
        var zip = Path.Combine(work, "update.zip");

        using (var http = new HttpClient { Timeout = Timeout.InfiniteTimeSpan })
        {
            http.DefaultRequestHeaders.UserAgent.ParseAdd("Z4Launcher/" + CurrentText);
            using var resp = await http.GetAsync(info.Url, HttpCompletionOption.ResponseHeadersRead);
            resp.EnsureSuccessStatusCode();
            var total = resp.Content.Headers.ContentLength ?? 0;
            using var hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
            await using var src = await resp.Content.ReadAsStreamAsync();
            await using var dst = File.Create(zip);
            var buf = new byte[81920];
            long done = 0;
            int n;
            while ((n = await src.ReadAsync(buf)) > 0)
            {
                await dst.WriteAsync(buf.AsMemory(0, n));
                hash.AppendData(buf, 0, n);
                done += n;
                if (total > 0) progress(done / (double)total);
            }
            if (info.Sha256 is { Length: > 0 })
            {
                var actual = Convert.ToHexString(hash.GetHashAndReset()).ToLowerInvariant();
                if (actual != info.Sha256) throw new Exception("The downloaded file does not match its checksum. The update was not installed.");
            }
        }

        var staging = Path.Combine(work, "files");
        ZipFile.ExtractToDirectory(zip, staging, true);
        var exeName = Path.GetFileName(Environment.ProcessPath) ?? "Z4ModernLauncher.exe";
        var exe = Directory.EnumerateFiles(staging, exeName, SearchOption.AllDirectories).FirstOrDefault()
                  ?? throw new Exception($"The update package does not contain {exeName}.");
        return Path.GetDirectoryName(exe)!;
    }

    /// <summary>Starts a helper that waits for this program to exit, copies the new files over it and starts it again.</summary>
    public static void ApplyAndRestart(string stagedDir)
    {
        var appDir = AppContext.BaseDirectory.TrimEnd('\\', '/');
        var exe = Environment.ProcessPath ?? Path.Combine(appDir, "Z4ModernLauncher.exe");
        var pid = Environment.ProcessId;
        var script = Path.Combine(Path.GetTempPath(), $"z4_update_{pid}.bat");
        var workRoot = new DirectoryInfo(stagedDir);
        while (workRoot.Parent is not null && !workRoot.Name.StartsWith("Z4Update_", StringComparison.Ordinal)) workRoot = workRoot.Parent;

        var bat = new StringBuilder();
        bat.AppendLine("@echo off");
        bat.AppendLine("set tries=0");
        bat.AppendLine(":wait");
        bat.AppendLine($"tasklist /FI \"PID eq {pid}\" 2>nul | find /i \"No tasks\" >nul");
        bat.AppendLine("if not errorlevel 1 goto copy");
        bat.AppendLine("set /a tries+=1");
        bat.AppendLine("if %tries% GTR 60 goto fail");
        bat.AppendLine("ping -n 2 127.0.0.1 >nul");
        bat.AppendLine("goto wait");
        bat.AppendLine(":copy");
        bat.AppendLine($"robocopy \"{stagedDir}\" \"{appDir}\" /E /IS /IT /R:5 /W:1 /NFL /NDL /NJH /NJS /NP >nul");
        bat.AppendLine("if errorlevel 8 goto fail");
        bat.AppendLine($"start \"\" \"{exe}\"");
        bat.AppendLine("goto cleanup");
        bat.AppendLine(":fail");
        bat.AppendLine($"echo The update could not be copied. Run the Z4 Client setup again. > \"{Path.Combine(appDir, "update_failed.txt")}\"");
        bat.AppendLine($"start \"\" \"{exe}\"");
        bat.AppendLine(":cleanup");
        bat.AppendLine($"rmdir /s /q \"{workRoot.FullName}\" 2>nul");
        bat.AppendLine("(goto) 2>nul & del \"%~f0\"");
        File.WriteAllText(script, bat.ToString().Replace("\r\n", "\n").Replace("\n", "\r\n"), Encoding.ASCII);

        Process.Start(new ProcessStartInfo("cmd.exe", $"/c \"{script}\"") { CreateNoWindow = true, UseShellExecute = false });
    }
}

using System.Windows;
using System.Windows.Media;
using System.Windows.Media.Imaging;
using System.Windows.Media.Media3D;

namespace Z4ModernLauncher;

/// <summary>Builds a rotatable 3D character (skin + overlay layers + optional cape) from the skin / cape textures.</summary>
public static class SkinViewer3D
{
    private sealed class Mesh
    {
        public readonly MeshGeometry3D Geo = new();

        public void Quad(Point3D a, Point3D b, Point3D c, Point3D d, Point ta, Point tb, Point tc, Point td)
        {
            var i = Geo.Positions.Count;
            Geo.Positions.Add(a); Geo.Positions.Add(b); Geo.Positions.Add(c); Geo.Positions.Add(d);
            Geo.TextureCoordinates.Add(ta); Geo.TextureCoordinates.Add(tb); Geo.TextureCoordinates.Add(tc); Geo.TextureCoordinates.Add(td);
            var n = Vector3D.CrossProduct(b - a, d - a);
            n.Normalize();
            for (var k = 0; k < 4; k++) Geo.Normals.Add(n);
            foreach (var idx in new[] { 0, 1, 2, 0, 2, 3 }) Geo.TriangleIndices.Add(i + idx);
        }
    }

    /// <summary>Minecraft box UV layout: u,v = texture origin; w,h,d = box size in texture pixels.</summary>
    private static void Box(Mesh m, double x0, double y0, double z0, double x1, double y1, double z1,
        double u, double v, double w, double h, double d, double tw, double th, bool mirror)
    {
        // returns the 4 corner texcoords (u0,v0 top-left ... u1,v1 bottom-right) of a region
        (double U0, double V0, double U1, double V1) R(double px, double py, double pw, double ph)
        {
            var a = px / tw; var b = (px + pw) / tw;
            return mirror ? (b, py / th, a, (py + ph) / th) : (a, py / th, b, (py + ph) / th);
        }
        var top = R(u + d, v, w, d);
        var bottom = R(u + d + w, v, w, d);
        var right = R(mirror ? u + d + w : u, v + d, d, h);      // character's right (-x) side
        var front = R(u + d, v + d, w, h);
        var left = R(mirror ? u : u + d + w, v + d, d, h);       // character's left (+x) side
        var back = R(u + 2 * d + w, v + d, w, h);

        // front (+z)
        m.Quad(new(x0, y0, z1), new(x1, y0, z1), new(x1, y1, z1), new(x0, y1, z1),
            new(front.U0, front.V1), new(front.U1, front.V1), new(front.U1, front.V0), new(front.U0, front.V0));
        // back (-z)
        m.Quad(new(x1, y0, z0), new(x0, y0, z0), new(x0, y1, z0), new(x1, y1, z0),
            new(back.U0, back.V1), new(back.U1, back.V1), new(back.U1, back.V0), new(back.U0, back.V0));
        // right (-x)
        m.Quad(new(x0, y0, z0), new(x0, y0, z1), new(x0, y1, z1), new(x0, y1, z0),
            new(right.U0, right.V1), new(right.U1, right.V1), new(right.U1, right.V0), new(right.U0, right.V0));
        // left (+x)
        m.Quad(new(x1, y0, z1), new(x1, y0, z0), new(x1, y1, z0), new(x1, y1, z1),
            new(left.U0, left.V1), new(left.U1, left.V1), new(left.U1, left.V0), new(left.U0, left.V0));
        // top (+y)
        m.Quad(new(x0, y1, z1), new(x1, y1, z1), new(x1, y1, z0), new(x0, y1, z0),
            new(top.U0, top.V1), new(top.U1, top.V1), new(top.U1, top.V0), new(top.U0, top.V0));
        // bottom (-y)
        m.Quad(new(x0, y0, z0), new(x1, y0, z0), new(x1, y0, z1), new(x0, y0, z1),
            new(bottom.U0, bottom.V1), new(bottom.U1, bottom.V1), new(bottom.U1, bottom.V0), new(bottom.U0, bottom.V0));
    }

    private static Brush TextureBrush(BitmapSource img)
    {
        var b = new ImageBrush(img) { Stretch = Stretch.Fill, ViewportUnits = BrushMappingMode.Absolute };
        RenderOptions.SetBitmapScalingMode(b, BitmapScalingMode.NearestNeighbor);
        return b;
    }

    public static Model3DGroup Build(BitmapSource skin, bool slim, BitmapSource? cape)
    {
        var group = new Model3DGroup();
        var legacy = skin.PixelHeight * 2 <= skin.PixelWidth + 1;        // old 64x32 skins
        double tw = 64, th = legacy ? 32 : 64;
        var aw = slim ? 3.0 : 4.0;

        var body = new Mesh();
        void Part(Mesh m, double x0, double y0, double z0, double x1, double y1, double z1, double e,
            double u, double v, double w, double h, double d, bool mirror = false) =>
            Box(m, x0 - e, y0 - e, z0 - e, x1 + e, y1 + e, z1 + e, u, v, w, h, d, tw, th, mirror);

        // head, body, right arm, right leg (left limbs follow below)
        Part(body, -4, 24, -4, 4, 32, 4, 0, 0, 0, 8, 8, 8);
        Part(body, -4, 12, -2, 4, 24, 2, 0, 16, 16, 8, 12, 4);
        Part(body, -4 - aw, 12, -2, -4, 24, 2, 0, 40, 16, aw, 12, 4);
        Part(body, -4, 0, -2, 0, 12, 2, 0, 0, 16, 4, 12, 4);                    // right leg
        if (legacy)
        {
            Part(body, 4, 12, -2, 4 + aw, 24, 2, 0, 40, 16, aw, 12, 4, true);   // left arm = mirrored right arm
            Part(body, 0, 0, -2, 4, 12, 2, 0, 0, 16, 4, 12, 4, true);           // left leg = mirrored right leg
        }
        else
        {
            Part(body, 4, 12, -2, 4 + aw, 24, 2, 0, 32, 48, aw, 12, 4);
            Part(body, 0, 0, -2, 4, 12, 2, 0, 16, 48, 4, 12, 4);
        }

        var layers = new Mesh();
        Part(layers, -4, 24, -4, 4, 32, 4, 0.5, 32, 0, 8, 8, 8);                // hat
        if (!legacy)
        {
            Part(layers, -4, 12, -2, 4, 24, 2, 0.25, 16, 32, 8, 12, 4);                 // jacket
            Part(layers, -4 - aw, 12, -2, -4, 24, 2, 0.25, 40, 32, aw, 12, 4);          // right sleeve
            Part(layers, 4, 12, -2, 4 + aw, 24, 2, 0.25, 48, 48, aw, 12, 4);            // left sleeve
            Part(layers, -4, 0, -2, 0, 12, 2, 0.25, 0, 32, 4, 12, 4);                   // right pants
            Part(layers, 0, 0, -2, 4, 12, 2, 0.25, 0, 48, 4, 12, 4);                    // left pants
        }

        var mat = new DiffuseMaterial(TextureBrush(skin));
        group.Children.Add(new GeometryModel3D(body.Geo, mat));
        group.Children.Add(new GeometryModel3D(layers.Geo, mat));

        if (cape is not null)
        {
            // cape textures are 64x32 (or HD multiples); the old OptiFine ones are 22x17
            var hd = cape.PixelWidth % 64 == 0;
            double ctw = hd ? 64 : 22, cth = hd ? 32 : 17;
            var cm = new Mesh();
            Box(cm, -5, 8, -3, 5, 24, -2, 0, 0, 10, 16, 1, ctw, cth, false);
            var capeModel = new GeometryModel3D(cm.Geo, new DiffuseMaterial(TextureBrush(cape)));
            var t = new Transform3DGroup();
            t.Children.Add(new RotateTransform3D(new AxisAngleRotation3D(new Vector3D(0, 1, 0), 180), new Point3D(0, 0, -2.5)));   // outside faces backwards
            t.Children.Add(new RotateTransform3D(new AxisAngleRotation3D(new Vector3D(1, 0, 0), 9), new Point3D(0, 24, -2.5)));    // slight tilt
            capeModel.Transform = t;
            group.Children.Add(capeModel);
        }
        return group;
    }
}

using System.Runtime.InteropServices;
using System.Windows;
using System.Windows.Interop;
using System.Windows.Media;

namespace Z4ModernLauncher;

/// <summary>Blur-behind window backgrounds: Mica / Acrylic on Windows 11, blur-behind on Windows 10.</summary>
internal static class WindowEffects
{
    [StructLayout(LayoutKind.Sequential)] private struct Margins { public int L, R, T, B; }
    [StructLayout(LayoutKind.Sequential)] private struct AccentPolicy { public int State, Flags, Gradient, Animation; }
    [StructLayout(LayoutKind.Sequential)] private struct CompositionData { public int Attribute; public IntPtr Data; public int Size; }

    [DllImport("dwmapi.dll")] private static extern int DwmSetWindowAttribute(IntPtr hwnd, int attr, ref int value, int size);
    [DllImport("dwmapi.dll")] private static extern int DwmExtendFrameIntoClientArea(IntPtr hwnd, ref Margins m);
    [DllImport("user32.dll")] private static extern int SetWindowCompositionAttribute(IntPtr hwnd, ref CompositionData data);

    /// <summary>Returns true when a see-through blurred background is active.</summary>
    public static bool Apply(Window window, string effect)
    {
        var hwnd = new WindowInteropHelper(window).Handle;
        if (hwnd == IntPtr.Zero) return false;
        var src = HwndSource.FromHwnd(hwnd);
        var build = Environment.OSVersion.Version.Build;

        var dark = 1;
        DwmSetWindowAttribute(hwnd, 20, ref dark, 4);                       // dark title/frame

        if (effect == "none" || build < 17134)
        {
            if (src?.CompositionTarget is not null) src.CompositionTarget.BackgroundColor = Color.FromRgb(0x0A, 0x0C, 0x12);
            if (build >= 22621) { var none = 1; DwmSetWindowAttribute(hwnd, 38, ref none, 4); }
            SetAccent(hwnd, 0);
            return false;
        }

        if (src?.CompositionTarget is not null) src.CompositionTarget.BackgroundColor = Colors.Transparent;
        var m = new Margins { L = -1, R = -1, T = -1, B = -1 };
        DwmExtendFrameIntoClientArea(hwnd, ref m);

        if (build >= 22621)
        {
            var type = effect == "mica" ? 2 : 3;                            // 2 = Mica, 3 = Acrylic
            return DwmSetWindowAttribute(hwnd, 38, ref type, 4) == 0;
        }
        SetAccent(hwnd, 3);                                                  // Windows 10: blur behind
        return true;
    }

    private static void SetAccent(IntPtr hwnd, int state)
    {
        try
        {
            var policy = new AccentPolicy { State = state, Flags = 2, Gradient = 0x01000000 };
            var size = Marshal.SizeOf(policy);
            var ptr = Marshal.AllocHGlobal(size);
            try
            {
                Marshal.StructureToPtr(policy, ptr, false);
                var data = new CompositionData { Attribute = 19, Data = ptr, Size = size };
                SetWindowCompositionAttribute(hwnd, ref data);
            }
            finally { Marshal.FreeHGlobal(ptr); }
        }
        catch { }
    }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Z4ModernLauncher</AssemblyName>
    <RootNamespace>Z4ModernLauncher</RootNamespace>
    <StartupObject>Z4ModernLauncher.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <Version>2.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- We supply our own Main (Program.cs) so startup crashes are always logged and shown. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
</Project>

<Application x:Class="Z4ModernLauncher.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>

  <!-- ===== Palette ===== -->
  <SolidColorBrush x:Key="BgBrush" Color="#0A0C12"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#0E1119"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#121624"/>
  <SolidColorBrush x:Key="Surface2Brush" Color="#1B2136"/>
  <!-- see-through layers (alpha is changed at runtime by the "Transparency" setting) -->
  <SolidColorBrush x:Key="TintBrush" Color="#690A0C12"/>
  <SolidColorBrush x:Key="SidebarGlassBrush" Color="#780B0E16"/>
  <SolidColorBrush x:Key="GlassBrush" Color="#8C121624"/>
  <SolidColorBrush x:Key="LineBrush" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F3F1FF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#8E97AE"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#C4B5FD"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#8B5CF6" Offset="0"/>
   <GradientStop Color="#6D5BFF" Offset="0.55"/>
   <GradientStop Color="#4F8BFF" Offset="1"/>
  </LinearGradientBrush>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- ===== Buttons (hover glow + springy press) ===== -->
  <Style x:Key="BaseButton" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="20,11"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" RenderTransformOrigin="0.5,0.5">
       <Border.RenderTransform><ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
       <Grid>
        <Border x:Name="hover" Background="White" Opacity="0" CornerRadius="12"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.16"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
         <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.38">
          <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/></DoubleAnimation.EasingFunction>
         </DoubleAnimation>
         <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.38">
          <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/></DoubleAnimation.EasingFunction>
         </DoubleAnimation>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="root" Property="Opacity" Value="0.4"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- ===== Window caption buttons ===== -->
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="46"/>
   <Setter Property="Height" Value="40"/>
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Setter Property="BorderBrush" Value="#22FFFFFF"/>
   <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
   <Setter Property="FontSize" Value="10"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
       <Border x:Name="hv" Background="{TemplateBinding BorderBrush}" Opacity="0"/>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="White"/>
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Setter Property="BorderBrush" Value="#E81123"/>
  </Style>

  <!-- ===== Sidebar navigation item ===== -->
  <Style x:Key="NavItem" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Setter Property="FontSize" Value="13.5"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,2"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Grid Height="44" Background="Transparent">
       <Border x:Name="hover" Background="White" Opacity="0" CornerRadius="13"/>
       <Border x:Name="sel" Background="{StaticResource AccentGradient}" Opacity="0" CornerRadius="13"/>
       <Border x:Name="bar" Width="3" Height="20" CornerRadius="2" Background="{StaticResource AccentSoftBrush}"
               HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="barScale" ScaleY="0"/></Border.RenderTransform>
       </Border>
       <ContentPresenter Margin="16,0,0,0" VerticalAlignment="Center">
        <ContentPresenter.RenderTransform><TranslateTransform x:Name="shift"/></ContentPresenter.RenderTransform>
       </ContentPresenter>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.15"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.28"/>
         <DoubleAnimation Storyboard.TargetName="barScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4">
          <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction>
         </DoubleAnimation>
         <DoubleAnimation Storyboard.TargetName="shift" Storyboard.TargetProperty="X" To="5" Duration="0:0:0.28">
          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
         </DoubleAnimation>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
         <DoubleAnimation Storyboard.TargetName="barScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.18"/>
         <DoubleAnimation Storyboard.TargetName="shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- ===== Tab pill (instance detail tabs) ===== -->
  <Style x:Key="TabPill" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Grid>
       <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13"/>
       <Border x:Name="hover" Background="White" Opacity="0" CornerRadius="13"/>
       <Border x:Name="sel" Background="{StaticResource AccentGradient}" Opacity="0" CornerRadius="13"/>
       <ContentPresenter Margin="16,9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.15"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="White"/>
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28">
          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
         </DoubleAnimation>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- ===== Card ===== -->
  <!-- ===== On/off switch ===== -->
  <Style x:Key="SwitchToggle" TargetType="ToggleButton">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#3DFFFFFF">
       <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
        <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="Opacity" Value="0.88"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
   <Setter Property="CornerRadius" Value="20"/>
   <Setter Property="Padding" Value="22"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- ===== TextBox / PasswordBox ===== -->
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="CaretBrush" Value="{StaticResource AccentSoftBrush}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
   <Setter Property="Padding" Value="14,0"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border Background="{StaticResource Surface2Brush}" CornerRadius="13" BorderThickness="1">
       <Border.BorderBrush><SolidColorBrush x:Name="bb" Color="#2EFFFFFF"/></Border.BorderBrush>
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <ColorAnimation Storyboard.TargetName="bb" Storyboard.TargetProperty="Color" To="#8B5CF6" Duration="0:0:0.2"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <ColorAnimation Storyboard.TargetName="bb" Storyboard.TargetProperty="Color" To="#2EFFFFFF" Duration="0:0:0.3"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="CaretBrush" Value="{StaticResource AccentSoftBrush}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
   <Setter Property="Padding" Value="14,0"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="PasswordBox">
      <Border Background="{StaticResource Surface2Brush}" CornerRadius="13" BorderThickness="1">
       <Border.BorderBrush><SolidColorBrush x:Name="bb" Color="#2EFFFFFF"/></Border.BorderBrush>
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <ColorAnimation Storyboard.TargetName="bb" Storyboard.TargetProperty="Color" To="#8B5CF6" Duration="0:0:0.2"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <ColorAnimation Storyboard.TargetName="bb" Storyboard.TargetProperty="Color" To="#2EFFFFFF" Duration="0:0:0.3"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- ===== ComboBox ===== -->
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="bd" Property="Background" Value="#262E52"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="FontSize" Value="13.5"/>
   <Setter Property="MaxDropDownHeight" Value="340"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton Focusable="False" ClickMode="Press"
         IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="{StaticResource Surface2Brush}" CornerRadius="13" BorderThickness="1">
           <Border.BorderBrush><SolidColorBrush x:Name="bb" Color="#2EFFFFFF"/></Border.BorderBrush>
           <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.8"
                 StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><RotateTransform x:Name="rot" Angle="0"/></Path.RenderTransform>
           </Path>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
             <ColorAnimation Storyboard.TargetName="bb" Storyboard.TargetProperty="Color" To="#3C4670" Duration="0:0:0.15"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
             <ColorAnimation Storyboard.TargetName="bb" Storyboard.TargetProperty="Color" To="#2EFFFFFF" Duration="0:0:0.25"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
           </Trigger>
           <Trigger Property="IsChecked" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
             <DoubleAnimation Storyboard.TargetName="rot" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.25">
              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
             </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
             <DoubleAnimation Storyboard.TargetName="rot" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.25">
              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
             </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
           </Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter IsHitTestVisible="False"
         Content="{TemplateBinding SelectionBoxItem}"
         ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
         ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
         Margin="14,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
       <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
              AllowsTransparency="True" Focusable="False" PopupAnimation="None">
        <Border x:Name="dd" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                Margin="0,6,0,18" Padding="5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="13">
         <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" Color="Black"/></Border.Effect>
         <Border.RenderTransform><TranslateTransform x:Name="ddShift" Y="0"/></Border.RenderTransform>
         <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsDropDownOpen" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="dd" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
         <DoubleAnimation Storyboard.TargetName="ddShift" Storyboard.TargetProperty="Y" From="-10" To="0" Duration="0:0:0.26">
          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
         </DoubleAnimation>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- ===== ListBox (result cards) ===== -->
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Margin" Value="0,0,0,10"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Grid>
       <Border CornerRadius="14" BorderThickness="1.5">
        <Border.BorderBrush><SolidColorBrush x:Name="selBrush" Color="#008B5CF6"/></Border.BorderBrush>
        <Grid>
         <ContentPresenter/>
         <Border x:Name="hov" Background="White" Opacity="0" CornerRadius="13" IsHitTestVisible="False"/>
        </Grid>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
