    private static string HumanSize(long bytes) =>
        bytes >= 1L << 20 ? $"{bytes / (1024.0 * 1024.0):0.0} MB" : bytes >= 1024 ? $"{bytes / 1024.0:0} KB" : $"{bytes} B";

    private void RefreshContent()
    {
        if (_detail is null) return;
        _content.Clear();
        var dir = Path.Combine(_detail.Path, _tab);
        try
        {
            Directory.CreateDirectory(dir);
            var entries = Directory.EnumerateFileSystemEntries(dir);
            var ordered = _tab == "screenshots"
                ? entries.OrderByDescending(p => File.GetLastWriteTimeUtc(p))                       // newest first
                : entries.OrderBy(p => Path.GetFileName(p), StringComparer.OrdinalIgnoreCase);
            foreach (var entry in ordered)
            {
                var name = Path.GetFileName(entry);
                var isDir = Directory.Exists(entry);
                var enabled = !name.EndsWith(".disabled", StringComparison.OrdinalIgnoreCase);
                var display = enabled ? name : name[..^".disabled".Length];
                var detail = isDir ? "World folder"
                    : _tab == "screenshots" ? $"{File.GetLastWriteTime(entry):yyyy-MM-dd HH:mm}  •  {HumanSize(new FileInfo(entry).Length)}"
                    : HumanSize(new FileInfo(entry).Length);
                _content.Add(new ContentItem(display, entry, enabled, isDir, detail));
            }
        }
        catch (Exception ex) { SetStatus("Could not read folder: " + ex.Message); }

        ContentEmpty.Visibility = _content.Count == 0 ? Visibility.Visible : Visibility.Collapsed;
        ContentEmptyText.Text = _tab switch
        {
            "mods" => "No mods in this instance yet.",
            "shaderpacks" => "No shader packs yet.",
            "resourcepacks" => "No resource packs yet.",
            "datapacks" => "No datapacks yet.",
            "screenshots" => "No screenshots yet. Press F2 in the game to take one.",
            _ => "No worlds yet."
        };
    }

