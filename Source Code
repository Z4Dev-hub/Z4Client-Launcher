        var picked = ContentList.SelectedItems.OfType<ContentItem>().Where(c => !c.IsDirectory).ToList();
        if (picked.Count == 0) { SetStatus("Select one or more files first."); return; }
        foreach (var item in picked)
        {
            try
            {
                var target = item.Enabled ? item.FullPath + ".disabled" : item.FullPath[..^".disabled".Length];
                File.Move(item.FullPath, target, true);
            }
            catch (Exception ex) { SetStatus("Could not toggle " + item.DisplayName + ": " + ex.Message); }
        }
        RefreshContent();
    }

    private void RemoveSelected_Click(object sender, RoutedEventArgs e)
    {
        if (_detail is null) return;
        var picked = ContentList.SelectedItems.OfType<ContentItem>().ToList();
        if (picked.Count == 0) { SetStatus("Select something to remove first."); return; }
        var label = picked.Count == 1 ? $"\"{picked[0].DisplayName}\"" : $"{picked.Count} items";
        if (MessageBox.Show(this, $"Remove {label} from {_detail.Name}?", "Remove", MessageBoxButton.YesNo, MessageBoxImage.Question) != MessageBoxResult.Yes) return;
        foreach (var item in picked)
        {
            try
            {
                if (item.IsDirectory) Directory.Delete(item.FullPath, true);
                else File.Delete(item.FullPath);
            }
            catch (Exception ex) { SetStatus("Could not remove " + item.DisplayName + ": " + ex.Message); }
        }
        RefreshInstanceEntry(_detail.Name);
        RefreshContent();
    }

    private void BrowseOnline_Click(object sender, RoutedEventArgs e)
    {
        switch (_tab)
        {
            case "shaderpacks": NavShaders.IsChecked = true; break;
            case "resourcepacks": NavResources.IsChecked = true; break;
            case "datapacks": NavDatapacks.IsChecked = true; break;
            case "saves": NavWorlds.IsChecked = true; break;
            default: NavMods.IsChecked = true; break;
        }
    }

    // ---------------------------------------------------------------- drag & drop
    private void Drop_Enter(object sender, DragEventArgs e)
    {
        if (e.Data.GetDataPresent(DataFormats.FileDrop)) DropOverlay.BeginAnimation(OpacityProperty, TweenTo(1, 160));
    }

    private void Drop_Over(object sender, DragEventArgs e)
    {
        e.Effects = e.Data.GetDataPresent(DataFormats.FileDrop) ? DragDropEffects.Copy : DragDropEffects.None;
        e.Handled = true;
    }

    private void Drop_Leave(object sender, DragEventArgs e) => DropOverlay.BeginAnimation(OpacityProperty, TweenTo(0, 220));

    private void Drop_Drop(object sender, DragEventArgs e)
    {
        DropOverlay.BeginAnimation(OpacityProperty, TweenTo(0, 220));
        if (e.Data.GetData(DataFormats.FileDrop) is string[] files) ImportPaths(files);
    }
