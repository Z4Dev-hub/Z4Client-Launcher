public record ContentItem(string DisplayName, string FullPath, bool Enabled, bool IsDirectory, string Detail)
{
    public bool IsScreenshot => string.Equals(System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(FullPath) ?? ""), "screenshots", StringComparison.OrdinalIgnoreCase);
    public double IconWidth => IsScreenshot ? 132 : 38;
    public double IconHeight => IsScreenshot ? 74 : 38;
    public ImageSource? Icon => LocalIcons.Load(FullPath, IsDirectory, IsScreenshot);
    public bool IsModFile => !IsDirectory && string.Equals(System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(FullPath) ?? ""), "mods", StringComparison.OrdinalIgnoreCase);
    public Visibility SwitchVisibility => IsDirectory || IsScreenshot ? Visibility.Collapsed : Visibility.Visible;
    public Visibility GearVisibility => IsModFile ? Visibility.Visible : Visibility.Collapsed;
    public Visibility StatusVisibility => IsDirectory || IsScreenshot ? Visibility.Visible : Visibility.Collapsed;
    public string Status => IsScreenshot ? "IMAGE" : IsDirectory ? "FOLDER" : Enabled ? "ENABLED" : "DISABLED";
    public double Dim => Enabled ? 1.0 : 0.45;
    public Brush Accent => Palette.For(DisplayName);
    public string Initial => DisplayName.Length > 0 ? DisplayName[..1].ToUpperInvariant() : "?";
}

