    private static InstanceInfo ReadInstance(string dir)
    {
        var version = "unspecified";
        var loader = "vanilla";
        var loaderVersion = "";
        try
        {
            var meta = Path.Combine(dir, "instance.json");
            if (File.Exists(meta))
            {
                var json = JsonNode.Parse(File.ReadAllText(meta));
                version = json?["version"]?.ToString() ?? version;
                loader = json?["loader"]?.ToString() ?? loader;
                loaderVersion = json?["loaderVersion"]?.ToString() ?? "";
            }
        }
        catch { }
        return new InstanceInfo(Path.GetFileName(dir), version, loader, dir, Summarize(dir), loaderVersion);
    }

    private static string Summarize(string dir)
    {
        int Count(string sub, bool dirs = false)
        {
            try
            {
                var p = Path.Combine(dir, sub);
                if (!Directory.Exists(p)) return 0;
                return dirs ? Directory.GetDirectories(p).Length : Directory.GetFiles(p).Length;
            }
            catch { return 0; }
        }
        return $"{Count("mods")} mods  •  {Count("shaderpacks")} shaders  •  {Count("resourcepacks")} resource packs  •  {Count("saves", true)} worlds";
    }

