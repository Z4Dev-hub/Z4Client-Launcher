    // ---------------------------------------------------------------- per-instance version
    private void ChangeVersion_Click(object sender, RoutedEventArgs e)
    {
        if (_detail is null) return;
        if (DetailVersionBox.SelectedItem is not MinecraftVersion picked) { SetStatus("Pick a version first."); return; }
        var inst = _detail;
        var newLoader = ((DetailLoaderBox.SelectedItem as System.Windows.Controls.ComboBoxItem)?.Content?.ToString() ?? "Vanilla").ToLowerInvariant();
        var newLv = DetailLoaderVersionBox.IsEnabled && DetailLoaderVersionBox.SelectedIndex > 0 ? DetailLoaderVersionBox.SelectedItem as string ?? "" : "";
        if (picked.Id == inst.Version && newLoader == (string.IsNullOrEmpty(inst.Loader) ? "vanilla" : inst.Loader) && newLv == inst.LoaderVersion)
        { SetStatus($"\"{inst.Name}\" already uses these settings."); return; }
        if (_playing) { SetStatus("Close the game before changing its version."); return; }

        var modsDir = Path.Combine(inst.Path, "mods");
        var hasMods = Directory.Exists(modsDir) && Directory.EnumerateFiles(modsDir).Any();
        if (hasMods && MessageBox.Show(this,
                $"Change \"{inst.Name}\" to {newLoader} {picked.Id}?\n\nMods installed for the current version/loader usually won't work afterwards. " +
                "Your worlds are kept, but older worlds can't be opened on an older game version afterwards.",
                "Change version", MessageBoxButton.YesNo, MessageBoxImage.Warning) != MessageBoxResult.Yes) return;

        try
        {
            var metaPath = Path.Combine(inst.Path, "instance.json");
            var json = File.Exists(metaPath) ? JsonNode.Parse(File.ReadAllText(metaPath))!.AsObject() : new JsonObject { ["name"] = inst.Name };
            json["version"] = picked.Id;
            json["loader"] = newLoader;
            json["loaderVersion"] = newLv;
            File.WriteAllText(metaPath, json.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
            RefreshInstanceEntry(inst.Name);
            var updated = _instances.First(i => i.Name == inst.Name);
            _detail = updated;
            DetailHint.Visibility = Visibility.Collapsed;
            DetailMeta.Text = $"{updated.Meta}{(updated.LoaderVersion.Length > 0 ? " (" + updated.LoaderVersion + ")" : "")}  •  {updated.Summary}";
            SetStatus($"\"{inst.Name}\" is now {updated.Meta}. Only this instance was changed.");
        }
        catch (Exception ex) { SetStatus("Could not change version: " + ex.Message); }
    }

